generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model dailytargetlog {
  id           String   @id @default(cuid())
  targetId     String
  userId       String
  date         DateTime
  balanceStart Float
  targetAmount Float
  actualPnl    Float
  isAchieved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  target       target   @relation(fields: [targetId], references: [id], map: "DailyTargetLog_targetId_fkey")
  user         user     @relation(fields: [userId], references: [id], map: "DailyTargetLog_userId_fkey")

  @@unique([userId, date], map: "DailyTargetLog_userId_date_key")
  @@index([targetId], map: "DailyTargetLog_targetId_fkey")
}

model rule {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String?     @db.Text
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  category    String?
  updatedAt   DateTime    @updatedAt
  user        user        @relation(fields: [userId], references: [id], map: "Rule_userId_fkey")
  traderule   traderule[]

  @@index([userId], map: "Rule_userId_fkey")
}

model scanner {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime
  pair           String
  volume         String
  bias           String
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  confidence     Int?
  currentPrice   Float
  lastHigh       Float
  lastLow        Float
  liquidityAbove Float?
  liquidityBelow Float?
  liquiditySide  String?
  obBearish      String?
  obBullish      String?
  obSide         String?
  pdArray        String
  pdPercent      Float
  structure      String?
  timeframe      String
  trend          String
  updatedAt      DateTime    @updatedAt
  volumeRatio    Float?
  user           user     @relation(fields: [userId], references: [id], map: "Scanner_userId_fkey")

  @@unique([userId, date, pair, timeframe], map: "Scanner_userId_date_pair_timeframe_key")
  @@index([userId, date], map: "Scanner_userId_date_idx")
  @@index([userId, pair, timeframe], map: "Scanner_userId_pair_timeframe_idx")
}

model target {
  id             String           @id @default(cuid())
  userId         String
  type           String
  name           String
  startBalance   Float
  targetBalance  Float
  dailyPercent   Float?
  deadline       DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  dailytargetlog dailytargetlog[]
  user           user             @relation(fields: [userId], references: [id], map: "Target_userId_fkey")

  @@index([userId], map: "Target_userId_fkey")
}

model trade {
  id             String         @id @default(cuid())
  userId         String
  pair           String
  direction      String
  entryPrice     Float
  pnl            Float
  pnlPercent     Float?
  screenshotUrl  String?
  notes          String?
  tags           String?
  isRuleViolated Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  exitPrice      Float?
  positionSize   Float?
  margin         Float?
  exitTime       DateTime?
  openTime       DateTime
  slPrice        Float?
  strategy       String?
  tpPrice        Float?
  status         String         @default("CLOSED")
  user           user           @relation(fields: [userId], references: [id], map: "Trade_userId_fkey")
  traderule      traderule[]
  partialclose   partialclose[]

  @@index([userId], map: "Trade_userId_idx")
  @@index([userId, openTime], map: "Trade_userId_openTime_idx")
  @@index([userId, pair], map: "Trade_userId_pair_idx")
  @@index([userId, status], map: "Trade_userId_status_idx")
}

model traderule {
  id        String   @id @default(cuid())
  tradeId   String
  ruleId    String
  createdAt DateTime @default(now())
  rule      rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade, map: "TradeRule_ruleId_fkey")
  trade     trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade, map: "TradeRule_tradeId_fkey")

  @@unique([tradeId, ruleId], map: "TradeRule_tradeId_ruleId_key")
  @@index([ruleId], map: "TradeRule_ruleId_idx")
  @@index([tradeId], map: "TradeRule_tradeId_idx")
}

model transaction {
  id        String   @id @default(cuid())
  userId    String
  type      String
  amount    Float
  note      String?
  date      DateTime
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], map: "Transaction_userId_fkey")

  @@index([userId], map: "Transaction_userId_fkey")
}

model user {
  id               String           @id @default(cuid())
  email            String           @unique(map: "User_email_key")
  password         String
  name             String
  createdAt        DateTime         @default(now())
  maxLossResetDate DateTime?
  maxLossType      String           @default("FIXED")
  maxLossValue     Float            @default(0)
  scannerEnabled   Boolean          @default(true)
  dailytargetlog   dailytargetlog[]
  rule             rule[]
  scanner          scanner[]
  target           target[]
  trade            trade[]
  transaction      transaction[]
  watchlistitem    watchlistitem[]
}

model watchlistitem {
  id        String   @id @default(cuid())
  userId    String
  pair      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], map: "WatchlistItem_userId_fkey")

  @@unique([userId, pair], map: "WatchlistItem_userId_pair_key")
  @@index([userId, order], map: "WatchlistItem_userId_order_idx")
}

model partialclose {
  id         String   @id @default(cuid())
  tradeId    String
  closeTime  DateTime
  closePrice Float
  closedSize Float
  pnl        Float
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  trade      trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade, map: "PartialClose_tradeId_fkey")

  @@index([tradeId], map: "PartialClose_tradeId_idx")
  @@index([tradeId, closeTime], map: "PartialClose_tradeId_closeTime_idx")
}
